<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputPath>..\Bin\UnitTest</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="excel.xlsx" />
    <!-- xunit 运行配置：并行测试集合 + 长测试告警，供 VS 与 dotnet test 共用 -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="excel.xlsx">
      <LogicalName>XUnitTest.excel.xlsx</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="Markdown\Fixtures\**\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NewLife.Core" Version="12.0.2026.1024" />
    <PackageReference Include="NewLife.UnitTest" Version="1.1.2026.301-beta0617" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.11" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- 竞品交叉兼容测试依赖（仅测试项目，不污染生产代码） -->
  <ItemGroup>
    <PackageReference Include="NPOI" Version="2.8.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <!-- Word 真实文件回归库：从 Bin 复制到测试输出，供往返/交叉测试使用 -->
  <ItemGroup>
    <None Include="Word\Fixtures\**\*.docx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NewLife.Office\NewLife.Office.csproj" />
    <ProjectReference Include="..\NewLife.Office.Cli\NewLife.Office.Cli.csproj" />
  </ItemGroup>

  <!-- Rendering 渲染扩展包测试（独立 NuGet 扩展，依赖 SkiaSharp；仅测试项目引用，不污染生产代码） -->
  <!-- NPOI 2.8.0 传递依赖 SkiaSharp 3.119.2 + SkiaSharp.NativeAssets.Linux.NoDependencies 3.119.2；
       托管程序集经下方向接引用统一到 4.151.1，但 Linux 原生 libSkiaSharp.so 仍会停留在 3.119（版本校验失败）。
       此处显式引用 4.151.1 的 Linux 原生包，并将 NoDependencies 以 ExcludeAssets 提升到 4.151.1（不贡献原生文件），
       保证 托管/原生 版本一致；Windows/macOS 原生库由 SkiaSharp 4.151.1 自带。 -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.1" ExcludeAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NewLife.Office.Rendering\NewLife.Office.Rendering.csproj" />
  </ItemGroup>

</Project>
